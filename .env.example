# PostgreSQL (local or Supabase). DIRECT_URL is optional — used for `prisma db push`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/crm_oquv_markaz?schema=public"
DIRECT_URL=""

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"

# Public settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="O'quv Markaz CRM"

# Optional: Telegram bot token (can also be set in Settings page)
TELEGRAM_BOT_TOKEN=""

# Optional: protects /api/cron/* endpoints (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""
